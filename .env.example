# Claude runs through AWS only. Credentials remain server-only.
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
# Local: set to 1 to use your existing AWS CLI/SDK profile.
AWS_BEDROCK_ENABLED=0
# Optional paid scan OCR through AWS Textract; production enables this for line highlights.
FOLIO_OCR_ENABLED=0
# Alternative: Bedrock API key supplied through the SDK's bearer-token variable.
# AWS_BEARER_TOKEN_BEDROCK=your-bedrock-api-key
# Vercel production: scoped OIDC role ARN; no static AWS access key needed.
FOLIO_AWS_ROLE_ARN=
# Required on Vercel: app client ID for the Cognito user pool with email verification.
# This is a public configuration ID. Region is BEDROCK_REGION above.
COGNITO_CLIENT_ID=
# Optional immutable Cognito subject IDs allowed into the existing shared assessment.
# All other verified accounts receive their own private workspace. Never use usernames here.
FOLIO_SHARED_ACCOUNT_SUBS=
# Private versioned S3 bucket for 50 MB direct uploads and speech processing.
FOLIO_S3_BUCKET=
# Optional LOCAL test password only. Production rejects this legacy login path.
# Localhost may run without authentication. Never commit actual credentials.
WORKSPACE_PASSWORD=
# Railway: mount a persistent volume here and set DATA_DIR=/data
DATA_DIR=./storage
PORT=8000
# Vercel: connect a PRIVATE Blob store. The integration supplies this variable.
BLOB_READ_WRITE_TOKEN=
DAILY_CHAT_LIMIT=30
